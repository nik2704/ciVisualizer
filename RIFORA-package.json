    "axios": "^0.27.2",
    "camel-case": "4.1.2",
    "classnames": "2.3.1",
    "dayjs": "1.10.7",
    "handy-filter": "1.2.0",
    "handy-filter-hook": "1.0.2",
    "history": "5.2.0",
    "mobx": "6.3.2",
    "mobx-react": "7.2.0",
    "notistack": "1.0.6-next.3",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-inlinesvg": "2.3.0",
